 package com.inmc.fishing.mechanic;
 
+import com.inmc.fishing.hook.MMOItemsHook;
+import org.bukkit.entity.Player;
+import org.bukkit.inventory.ItemStack;
+import org.bukkit.inventory.meta.Damageable;
+import org.bukkit.inventory.meta.ItemMeta;
+
 public class RodDurabilityHandler {
+    private final MMOItemsHook mmoItemsHook;
+
+    public RodDurabilityHandler(MMOItemsHook mmoItemsHook) {
+        this.mmoItemsHook = mmoItemsHook;
+    }
 
     public void applyDurabilityLoss(Player player, ItemStack rod, int damage) {
-        // 기존 바닐라 방식만 적용
-        if (rod != null && rod.getItemMeta() instanceof Damageable) {
+        if (rod == null) return;
+        if (mmoItemsHook.isLoaded() && mmoItemsHook.isMMOItem(rod)) {
+            mmoItemsHook.reduceDurability(player, rod, damage);
+            return;
+        }
+        // 바닐라 처리
+        if (rod.getItemMeta() instanceof Damageable) {
             Damageable meta = (Damageable) rod.getItemMeta();
             int newDurability = meta.getDamage() + damage;
             if (newDurability >= rod.getType().getMaxDurability()) {
                 rod.setAmount(0);
+            } else {
+                meta.setDamage(newDurability);
+                rod.setItemMeta((ItemMeta) meta);
             }
         }
     }
