+        World world = location.getWorld();
+        WeatherType type = world.isThundering() ? WeatherType.THUNDER :
+                          world.hasStorm() ? WeatherType.RAIN :
+                          WeatherType.CLEAR;
+        return multipliers.getOrDefault(type, 1.0);
     }
