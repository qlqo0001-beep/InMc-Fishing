@@ -0,0 +1,38 @@
+package com.inmc.fishing.command;
+
+import com.inmc.fishing.FishingService;
+import com.inmc.fishing.SimulationResult;
+import org.bukkit.Bukkit;
+import org.bukkit.command.Command;
+import org.bukkit.command.CommandExecutor;
+import org.bukkit.command.CommandSender;
+import org.bukkit.entity.Player;
+
+public class PlayerSimulateCommand implements CommandExecutor {
+    private final FishingService service;
+
+    public PlayerSimulateCommand(FishingService service) {
+        this.service = service;
+    }
+
+    @Override
+    public boolean onCommand(CommandSender sender, Command cmd, String label, String[] args) {
+        if (args.length < 3) {
+            sender.sendMessage("Usage: /fishing simulate player <player> [count]");
+            return true;
+        }
+        Player target = Bukkit.getPlayer(args[2]);
+        if (target == null) {
+            sender.sendMessage("Player not found.");
+            return true;
+        }
+        int count = 1000;
+        if (args.length >= 4) {
+            try { count = Integer.parseInt(args[3]); } catch (NumberFormatException e) {
+                sender.sendMessage("Invalid count.");
+                return true;
+            }
+        }
+        SimulationResult result = service.simulateForPlayer(target, count);
+        sender.sendMessage("Player simulation result for " + target.getName() + ":");
+        result.getDistribution().forEach((fish, prob) ->
+                sender.sendMessage(fish + ": " + String.format("%.2f%%", prob * 100)));
+        return true;
+    }
+}
